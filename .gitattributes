# Force LF line endings so the shebang and the script work on every checkout
# (CRLF breaks "#!/usr/bin/env bash" and makes bash print "$'\r': command not found").
* text=auto
*.sh    text eol=lf
*.bash  text eol=lf
*.bats  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Makefile text eol=lf
